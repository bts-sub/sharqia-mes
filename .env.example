# ============================================================
# Sharqia MES — environment configuration (EXAMPLE)
# Copy to `.env` and fill with YOUR values. Never commit `.env`.
# No real server, database, or credentials are shipped in this repo.
# ============================================================

# Data source: "mock" (local JSON, default for development) or "odoo".
# Keep "mock" until your Odoo custom module + fields are confirmed.
SHARQIA_DATA_SOURCE=mock

# ---- Odoo 19 SaaS connection (leave blank until you connect) ----
# Base URL of your Odoo instance, e.g. https://yourcompany.odoo.com
ODOO_URL=

# Odoo database name (Odoo SaaS usually derives it from the subdomain;
# set it explicitly if your login endpoint requires it).
ODOO_DATABASE=

# Optional: a dedicated API gateway in front of Odoo (if you use one).
# If empty, the app talks to ODOO_URL directly via JSON-RPC.
ODOO_API_URL=

# ---- Authentication ----
# "session"  -> Odoo web session login (/web/session/authenticate) + cookies
# "apikey"   -> per-user Odoo API key sent to /jsonrpc (recommended for SaaS)
ODOO_AUTH_MODE=session

# Request timeout (ms) and retry attempts for network calls.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# Log level for development: debug | info | warn | error | silent
LOG_LEVEL=debug
