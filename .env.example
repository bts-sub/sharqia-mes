# ============================================================
# Sharqia MES — environment configuration
# `scripts/build-web.js` reads `.env` if present, else this file, and writes
# `www/env.js`. These defaults are the deployed setup and hold no secrets:
# the Odoo URL, database and service account live in the portal, not here.
# ============================================================

# Data source: "odoo" (live) or "mock" (the app's own demo data, offline).
SHARQIA_DATA_SOURCE=odoo

# ---- Authentication ----
# "gateway"  -> through the Sharqia portal (/api/mes, same origin via nginx).
#               Workers sign in with their portal account; their app role is
#               «دور تطبيق التصنيع» (mes_role) on the Odoo employee form.
# "session"  -> Odoo web session login (/web/session/authenticate) + cookies
# "apikey"   -> per-user Odoo API key sent to /jsonrpc
ODOO_AUTH_MODE=gateway
MES_GATEWAY=/api/mes

# ---- Direct Odoo connection (session/apikey modes only) ----
ODOO_URL=
ODOO_DATABASE=
ODOO_API_URL=

# Request timeout (ms) and retry attempts for network calls.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# Log level: debug | info | warn | error | silent
LOG_LEVEL=info
